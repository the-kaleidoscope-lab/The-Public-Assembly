# --- AI (GEMINI) ---
# Server-side Gemini API key
GEMINI_API_KEY=

# --- EMAIL (GMAIL SMTP) ---
# Gmail address and 16-character App Password
GMAIL_USER=
GMAIL_PASS=
ADMIN_EMAIL=

# --- FIREBASE ADMIN (Optional service account credentials) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
