{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Public Assembly platform.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "The user's full name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "The user's role." },
        "city": { "type": "string", "description": "The user's city." },
        "skills": { "type": "string", "description": "The user's skills." },
        "volunteerHours": { "type": "integer", "description": "Total volunteer hours." },
        "impactScore": { "type": "integer", "description": "The user's impact score." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["fullName", "email", "role"]
    },
    "Initiative": {
      "title": "Initiative",
      "description": "A community-led project or action.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the initiative." },
        "description": { "type": "string", "description": "A detailed description." },
        "category": { "type": "string", "description": "The category (e.g., Environment)." },
        "city": { "type": "string", "description": "The city where it takes place." },
        "createdBy": { "type": "string", "description": "The UID of the creator." },
        "estimatedCost": { "type": "number", "description": "The estimated budget." },
        "suppliesNeeded": { "type": "string", "description": "List of supplies needed." },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Completed"], "description": "Current status." },
        "verified": { "type": "boolean", "description": "Whether the initiative is verified." },
        "emergency": { "type": "boolean", "description": "Whether it's an emergency." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was created." }
      },
      "required": ["title", "description", "category", "city", "createdBy"]
    },
    "Task": {
      "title": "Task",
      "description": "A specific task within an initiative.",
      "type": "object",
      "properties": {
        "initiativeId": { "type": "string", "description": "The ID of the parent initiative." },
        "title": { "type": "string", "description": "The task title." },
        "description": { "type": "string", "description": "The task description." },
        "assignedTo": { "type": "string", "description": "The UID of the assigned volunteer." },
        "status": { "type": "string", "enum": ["todo", "in-progress", "completed"], "description": "Current status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was created." }
      },
      "required": ["initiativeId", "title", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in an initiative or task chat.",
      "type": "object",
      "properties": {
        "initiativeId": { "type": "string", "description": "The parent initiative ID." },
        "taskId": { "type": "string", "description": "The parent task ID (optional)." },
        "userId": { "type": "string", "description": "The UID of the sender." },
        "text": { "type": "string", "description": "The message text." },
        "fileUrl": { "type": "string", "description": "URL of an attached file." },
        "fileName": { "type": "string", "description": "Name of the attached file." },
        "fileType": { "type": "string", "description": "MIME type of the file." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was sent." }
      },
      "required": ["initiativeId", "userId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/initiatives/{initiativeId}": {
      "schema": "Initiative",
      "description": "Initiative details."
    },
    "/initiatives/{initiativeId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks for an initiative."
    },
    "/initiatives/{initiativeId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages for an initiative chat."
    }
  }
}
